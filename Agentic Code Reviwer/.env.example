# =====================================================================
# PR Sage Configuration Environment Variables
# =====================================================================

# GitHub Fine-grained Personal Access Token (PAT)
# Scoped to target repository with 'Pull requests: Read & Write', 'Contents: Read-only'
# Required when DRY_RUN=false
GITHUB_TOKEN=github_pat_11A...

# Target GitHub repository in 'owner/repo' format (e.g. octocat/Hello-World)
REPO=your-username/your-repo

# Groq Cloud API (free tier: llama-3.1-8b-instant)
# Get your API key at https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxx
GROQ_BASE_URL=https://api.groq.com/openai/v1
MODEL_NAME=llama-3.1-8b-instant

# Review Guardrails (Noise & Rate Control)
MAX_COMMENTS_PER_PR=10
MAX_COMMENTS_PER_FILE=5

# Code Chunking & File Limits (characters/bytes & lines)
MAX_FILE_SIZE=200000
CHUNK_SIZE_LINES=150
CHUNK_OVERLAP_LINES=20

# Paths to skip during diff parsing (JSON formatted list or comma-separated)
SKIP_PATHS=["package-lock.json","yarn.lock","poetry.lock","*.min.js","*.min.css","*.lock","*.png","*.jpg","*.svg","dist/*","build/*"]

# Operational Flags
# Set DRY_RUN=true to run local review pipeline without calling GitHub POST review API
DRY_RUN=false

# Networking & Retry Settings
REQUEST_TIMEOUT=30.0
MAX_RETRIES=3
